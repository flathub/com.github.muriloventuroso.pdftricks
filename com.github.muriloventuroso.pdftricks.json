{
    "app-id": "com.github.muriloventuroso.pdftricks",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "base": "io.elementary.BaseApp",
    "base-version": "tanit-26.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.vala"
    ],
    "build-options": {
        "prepend-path": "/usr/lib/sdk/vala/bin/",
        "prepend-ld-library-path": "/usr/lib/sdk/vala/lib"
    },
    "command": "com.github.muriloventuroso.pdftricks",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup": [
        "/share/doc",
        "/share/ghostscript",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "cleanup-commands": [
        "/app/cleanup-BaseApp.sh"
    ],
    "modules": [
        {
            "name": "libgee",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libgee/0.20/libgee-0.20.8.tar.xz",
                    "sha256": "189815ac143d89867193b0c52b7dc31f3aa108a15f04d6b5dca2b6adfad0b0ee"
                }
            ]
        },
        {
            "name": "ghostscript",
            "config-opts": [
                "--disable-cups",
                "--without-tesseract"
            ],
            "build-options": {
                "arch": {
                    "aarch64": {
                        "cppflags": "-DPNG_ARM_NEON_OPT=0"
                    }
                }
            },
            "make-args": [
                "so"
            ],
            "make-install-args": [
                "soinstall"
            ],
            "cleanup": [
                "/bin/dvipdf",
                "/bin/font2c",
                "/bin/gsbj",
                "/bin/gsdj500",
                "/bin/gslp",
                "/bin/lprsetup.sh",
                "/bin/pdf2ps",
                "/bin/pf2afm",
                "/bin/printafm",
                "/bin/ps2epsi",
                "/bin/ps2pdfwr",
                "/bin/ps2pdf13",
                "/bin/wftopfa",
                "/bin/eps2eps",
                "/bin/gsdj",
                "/bin/gslj",
                "/bin/gsnd",
                "/bin/pdf2dsc",
                "/bin/pfbtopfa",
                "/bin/pphs",
                "/bin/ps2ascii",
                "/bin/ps2pdf",
                "/bin/ps2pdf12",
                "/bin/ps2pdf14",
                "/bin/ps2ps2",
                "/bin/unix-lpr.sh"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs10071/ghostscript-10.07.1.tar.gz",
                    "sha256": "2fc74362f9be6fae1b0a65d38fdcfd4f0b518cc3b07c5581fb661eb4d2e15251",
                    "__x-checker-data": {
                        "type": "anitya",
                        "project-id": 1157,
                        "stable-only": true,
                        "url-template": "https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs${major}0$minor$patch/ghostscript-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "imagemagick",
            "config-opts": [
                "--enable-static=yes",
                "--disable-docs",
                "--with-png",
                "--with-jpeg",
                "--with-zlib",
                "--with-gvc=no",
                "--enable-zero-configuration"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/ImageMagick/ImageMagick/archive/7.1.2-23.tar.gz",
                    "sha256": "f129f7d87fc21da453d032dd291b80ea13faf2497f13ef8279d97759ed7d5c46",
                    "__x-checker-data": {
                        "type": "anitya",
                        "project-id": 1372,
                        "stable-only": true,
                        "url-template": "https://github.com/ImageMagick/ImageMagick/archive/$version.tar.gz"
                    }
                },
                {
                    "type": "patch",
                    "path": "patches/magick-policy.patch"
                }
            ]
        },
        {
            "name": "pdftricks",
            "buildsystem": "meson",
            "license-files": [
                "debian/copyright"
            ],
            "post-install": [
                "mkdir -p /app/share/icons/hicolor/scalable/apps",
                "mv /app/share/icons/hicolor/128x128@2/apps/*.svg -t /app/share/icons/hicolor/scalable/apps/",
                "mv /app/share/icons/hicolor/128x128/apps/${FLATPAK_ID}.svg -t /app/share/icons/hicolor/scalable/apps/",
                "find /app/share/icons/hicolor -type f -not -path \"*scalable*\" -not -path \"*actions*\" -name \"*.svg\" -delete"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/muriloventuroso/pdftricks.git",
                    "//note": "Use the latest commit from repository to get translation updates",
                    "commit": "7cad1fe906b3298461a3a43b405070a3a344bc8f"
                },
                {
                    "type": "patch",
                    "paths": [
                        "patches/apply-eos-theme.patch",
                        "patches/pdftricks-meson.patch",
                        "patches/fix_appdata.patch"
                    ]
                }
            ]
        }
    ]
}
